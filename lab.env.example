# Copy to lab.env (gitignored) on every machine that runs a recipe.

# The osapi checkout `just build` compiles, on the hub.
LAB_OSAPI_DIR=~/git/osapi-io/osapi

# The hub's address as a remote agent dials it for NATS, such as its Tailscale
# name. The VMs do not use it: they reach the hub on the vmnet bridge.
LAB_HUB_ADDR=

# How a remote machine reaches the hub over SSH, as `ssh` takes it: a host alias
# from ~/.ssh/config, or user@host.
LAB_HUB_SSH=

# The hub's lab checkout, as seen from a remote machine.
LAB_HUB_DIR=git/osapi-io/osapi-lab
