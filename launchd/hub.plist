<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One hub process, run by launchd. `just hub-install` writes two copies to
  ~/Library/LaunchAgents: io.osapi.lab.nats runs `osapi nats server start` and
  io.osapi.lab.controller runs `osapi controller start`. LAB_ARGS is the
  command's words, each already wrapped in <string>. KeepAlive restarts the
  controller until NATS is up, so the two need no ordering.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.osapi.lab.${LAB_COMPONENT}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${LAB_STATE}/bin/osapi-darwin-arm64</string>
    <string>-f</string>
    <string>${LAB_STATE}/config/hub.yaml</string>
    ${LAB_ARGS}
  </array>
  <key>WorkingDirectory</key>
  <string>${LAB_STATE}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>${LAB_STATE}/log/${LAB_COMPONENT}.log</string>
  <key>StandardErrorPath</key>
  <string>${LAB_STATE}/log/${LAB_COMPONENT}.log</string>
</dict>
</plist>
