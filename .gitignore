.just/
.worktrees/

# Everything a lab generates on this machine: builds, rendered configs,
# secrets, the VMs' SSH key.
.lab/

# A global gitignore often excludes .envrc. This one holds no names or secrets,
# so it is committed.
!.envrc

# Claude Code local state.
.claude/settings.local.json
.claude/worktrees/

# The real inventory names your machines; the venv is uv's.
ansible/inventory.yml
ansible/.venv/
