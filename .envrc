# direnv: in this directory, `osapi` is the lab's build and talks to the lab.
# `just build` and `just push` write both; nothing here names a machine.
PATH_add .lab/bin
export OSAPI_OSAPIFILE="$PWD/.lab/config/cli.yaml"
# The nats CLI, pointed at the lab's NATS with its own credentials. `just site`
# or `just client` writes the file.
dotenv_if_exists .lab/config/nats.env
