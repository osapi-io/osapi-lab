# direnv: this machine's settings, and `osapi` in this directory is the lab's
# build talking to the lab.
#
# Machine names and paths live only in lab.env, which is gitignored; copy
# lab.env.example to start one. This file holds no names and no secrets, so it
# is committed.
dotenv_if_exists lab.env

PATH_add .lab/bin

# On the hub, the hub's own config; anywhere else, the client config.
if [ -f .lab/config/hub.yaml ]; then
  export OSAPI_OSAPIFILE="$PWD/.lab/config/hub.yaml"
else
  export OSAPI_OSAPIFILE="$PWD/.lab/config/client.yaml"
fi
