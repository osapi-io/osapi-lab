# Jaeger for the lab, in memory. OTLP gRPC on every interface, so that the VMs
# and remote agents can send traces. The UI only on the hub's tailnet address,
# because it has no authentication: a machine on the tailnet can open it, and a
# machine on the hub's local network cannot. Both serve the hub's Tailscale
# certificate, as the controller's API does.
service:
  extensions: [jaeger_storage, jaeger_query]
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [jaeger_storage_exporter]

extensions:
  jaeger_query:
    storage:
      traces: memstore
    http:
      endpoint: {{ jaeger_ui_addr }}:{{ lab_tracing_ui_port }}
      tls:
        cert_file: {{ hub_state }}/tls/api.crt
        key_file: {{ hub_state }}/tls/api.key
    grpc:
      endpoint: 127.0.0.1:16685

  jaeger_storage:
    backends:
      memstore:
        memory:
          max_traces: 100000

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:{{ lab_tracing_otlp_port }}
        tls:
          cert_file: {{ hub_state }}/tls/api.crt
          key_file: {{ hub_state }}/tls/api.key

processors:
  batch:

exporters:
  jaeger_storage_exporter:
    trace_storage: memstore
