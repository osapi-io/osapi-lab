# {{ ansible_managed }}
# One agent. The client role renders this too, for a remote agent.
#
# osapi validates the whole file whatever the command, so an agent's config has
# to carry controller.api.security.signing_key,
# controller.client.security.bearer_token and controller.nats.port even though
# the agent uses none of them. These are throwaway values, never the hub's.

controller:
  client:
    security:
      bearer_token: unused-by-the-agent
  api:
    security:
      signing_key: {{ lab_agent_dummy_key }}
  nats:
    port: 4222

agent:
  hostname: {{ agent_node }}
  labels:
    distro: {{ agent_distro }}
  nats:
    host: {{ agent_nats_host }}
    port: 4222
    client_name: osapi-agent
    namespace: osapi
    auth:
      type: user_pass
      username: osapi
      password: {{ lab_nats_password }}
  metrics:
    enabled: false
  privilege_escalation:
    enabled: false

# The agent binds to buckets the NATS server created; these names have no
# default, so they are repeated from the hub role's template.
nats:
  facts:
    bucket: agent-facts
  state:
    bucket: agent-state
  objects:
    bucket: file-objects
  file_state:
    bucket: file-state
  audit:
    stream: AUDIT
    subject: audit

telemetry:
  tracing:
    enabled: false
