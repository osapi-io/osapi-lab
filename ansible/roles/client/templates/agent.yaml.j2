# The config of the remote agent, `just agent`: this machine as one of the
# lab's agents. It joins at its first start with the join string, and keeps
# its keys and its NATS user in agent.pki.key_dir. Later starts use those.
agent:
  join: {{ agent_join }}
  labels:
    distro: {{ agent_distro }}
  pki:
    key_dir: {{ agent_key_dir }}

telemetry:
  tracing:
    enabled: true
    exporter: otlp
    otlp_endpoint: {{ lab_hub_addr }}:{{ lab_tracing_otlp_port }}
    tls:
      enabled: true
