# {{ ansible_managed }}
# `osapi client ...` on this machine, against the hub's API. The signing keys
# are the hub's own, so that `osapi controller token generate` and `osapi
# controller token validate` here make and check tokens the controller accepts.
# Ansible made the keys on this machine; a VM has none, so it cannot sign a
# token.

controller:
  client:
    url: https://{{ lab_hub_addr }}:{{ lab_api_port }}
    security:
      bearer_token: {{ lab_token }}
  api:
    security:
      signing_keys:
{% for k in lab_signing_keys %}
        - id: {{ k.id }}
          key: {{ k.key }}
{% endfor %}
