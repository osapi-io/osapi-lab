# {{ ansible_managed }}
# The hub: osapi's embedded NATS server and the controller. Bucket and stream
# settings follow configs/osapi.yaml in the osapi repository; most of them have
# no default.

controller:
  client:
    url: http://localhost:8080
    security:
      bearer_token: {{ lab_token }}
  ui:
    enabled: true
    # Where a person opens each part; health shows it beside the bind address.
    url: {{ lab_controller_url }}
  api:
    port: 8080
    url: {{ lab_controller_url }}
    job_timeout: 30s
    security:
      signing_keys:
{% for k in lab_signing_keys %}
        - id: {{ k.id }}
          key: {{ k.key }}
{% endfor %}
      cors:
        allow_origins: []
  nats:
    host: localhost
    port: 4222
    client_name: osapi-controller
    namespace: osapi
    # Its own user in osapi's NATS account; osapi nats setup uses it too.
    auth:
      type: creds
      creds_file: {{ hub_state }}/secrets/controller.creds
  # Metrics have no authentication, so they answer the hub only.
  metrics:
    enabled: true
    host: 127.0.0.1
    port: 9090
  # Agents enroll with a key and every job response is verified against it.
  # auto_admit, because each push reclones the VMs and they ask to join afresh.
  pki:
    enabled: true
    key_dir: {{ hub_state }}/pki
    auto_admit: true
    # A VM that is cloned again is deleted from admission first (lab_vm). This
    # deletes one that went away some other way, such as by hand, when it has
    # not reported for a day.
    delete_after: 24h
  notifications:
    enabled: true
    notifier: log
    renotify_interval: 5m

nats:
  server:
    # Every interface, because the Tart VMs reach the hub on the vmnet bridge
    # and remote agents over Tailscale. Operator mode refuses any connection
    # without a user JWT that osapi's account signed.
    host: 0.0.0.0
    port: {{ lab_nats_port }}
    url: {{ lab_nats_url }}
    store_dir: {{ hub_state }}/jetstream
    namespace: osapi
    auth:
      type: operator
      # The operator, the system account and each account's JWT, from nsc.
      resolver_file: {{ hub_state }}/config/resolver.conf
      # The server's own user, which its setup and heartbeat connect as.
      creds_file: {{ hub_state }}/secrets/nats.creds
    metrics:
      enabled: true
      host: 127.0.0.1
      port: 9092
  stream:
    name: JOBS
    subjects: jobs.>
    max_age: 24h
    max_msgs: 10000
    storage: file
    replicas: 1
    discard: old
  kv:
    bucket: job-queue
    response_bucket: job-responses
    # How long a job stays on the Jobs page and in job get. It matches the
    # JOBS stream's max_age. With 1h, every job older than an hour went at
    # once each time the hub connected (osapi-io/osapi#1096).
    ttl: 24h
    max_bytes: 104857600
    storage: file
    replicas: 1
  dlq:
    max_age: 168h
    max_msgs: 1000
    storage: file
    replicas: 1
  audit:
    stream: AUDIT
    subject: audit
    max_age: 720h
    max_bytes: 52428800
    storage: file
    replicas: 1
  registry:
    bucket: agent-registry
    ttl: 30s
    storage: file
    replicas: 1
  facts:
    bucket: agent-facts
    ttl: 5m
    storage: file
    replicas: 1
  state:
    bucket: agent-state
    storage: file
    replicas: 1
  objects:
    bucket: file-objects
    max_bytes: 10737418240
    storage: file
    replicas: 1
  file_state:
    bucket: file-state
    storage: file
    replicas: 1

telemetry:
  tracing:
    enabled: true
    exporter: otlp
    otlp_endpoint: 127.0.0.1:{{ lab_tracing_otlp_port }}
    # The Jaeger UI, which osapi links to and does not run.
    url: {{ lab_tracing_view_url }}
