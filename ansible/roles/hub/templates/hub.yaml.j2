# {{ ansible_managed }}
# The hub: osapi's embedded NATS server and the controller. Each key that is
# not here has its default; osapi config default get prints them all.

controller:
  client:
    # The certificate is for the hub's Tailscale name, not localhost.
    url: {{ lab_controller_url }}
    security:
      bearer_token: {{ lab_token }}
  # Where a person opens each part; health shows it beside the bind address.
  ui:
    url: {{ lab_controller_url }}
  api:
    url: {{ lab_controller_url }}
    tls:
      enabled: true
      cert_file: {{ hub_state }}/tls/api.crt
      key_file: {{ hub_state }}/tls/api.key
    security:
      # The lab's own keys, so that cli.yaml on this machine signs tokens that
      # the controller accepts.
      signing_keys:
{% for k in lab_signing_keys %}
        - id: {{ k.id }}
          key: {{ k.key }}
{% endfor %}
  nats:
    port: {{ lab_nats_port }}
    # Its own user in osapi's NATS account; osapi nats setup uses it too.
    auth:
      type: creds
      creds_file: {{ hub_state }}/secrets/controller.creds
  # Metrics have no authentication, so they answer the hub only.
  metrics:
    host: 127.0.0.1
  pki:
    key_dir: {{ hub_state }}/pki
    # Each push clones the VMs again, and they ask to join again.
    auto_admit: true
    # A VM that is cloned again is deleted from admission first (lab_vm). This
    # deletes one that went away some other way, such as by hand, when it has
    # not reported for a day.
    delete_after: 24h
  # The vault of the secrets, with its key in the hub's state, not in
  # /etc/osapi. The controller makes the key at its first start.
  secrets:
    vaults:
      - name: default
        type: nats
        key_file: {{ hub_state }}/secrets/vault-default.key

nats:
  server:
    # Every interface, because the Tart VMs reach the hub on the vmnet bridge
    # and remote agents over Tailscale. Operator mode refuses any connection
    # without a user JWT that osapi's account signed.
    host: 0.0.0.0
    port: {{ lab_nats_port }}
    url: {{ lab_nats_url }}
    store_dir: {{ hub_state }}/jetstream
    # Each stream and bucket in store_dir is encrypted with this key. The hub
    # role makes it with osapi nats key create, one time.
    jetstream:
      key_file: {{ hub_state }}/secrets/jetstream.key
    auth:
      type: operator
      # The operator, the system account and each account's JWT, from nsc.
      resolver_file: {{ hub_state }}/config/resolver.conf
      # The server's own user, which its setup and heartbeat connect as.
      creds_file: {{ hub_state }}/secrets/nats.creds
    metrics:
      host: 127.0.0.1
  kv:
    # How long a job stays on the Jobs page and in job get. It matches the
    # JOBS stream's max_age. With 1h, every job older than an hour went at
    # once each time the hub connected (osapi-io/osapi#1096).
    ttl: 24h

telemetry:
  tracing:
    enabled: true
    exporter: otlp
    otlp_endpoint: 127.0.0.1:{{ lab_tracing_otlp_port }}
    # Jaeger serves the hub's Tailscale certificate, which names the hub, not
    # 127.0.0.1. The trace reader uses the same block.
    tls:
      enabled: true
      server_name: {{ lab_hub_addr }}
    # The Jaeger UI, which osapi links to and does not run.
    url: {{ lab_tracing_view_url }}
